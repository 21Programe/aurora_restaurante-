# Aurora Restaurante — configuração local
APP_NAME=Aurora Restaurante
APP_VERSION=2.0.0

# Obrigatório para assinar tokens JWT.
# Gere um valor aleatório forte e mantenha este arquivo fora do Git.
SECRET_KEY=

# Banco
DATABASE_URL=sqlite:///./aurora_restaurante.db

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origens autorizadas, separadas por vírgula.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
